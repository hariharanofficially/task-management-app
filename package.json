{
  "name": "task-management-app",
  "version": "1.0.0",
  "description": "Full-stack Task Management App built with React, Vite, ASP.NET Core (.NET 8 Web API), and SQLite",
  "scripts": {
    "install:frontend": "npm --prefix frontend install",
    "restore:backend": "cd backend && run.bat restore",
    "build:backend": "cd backend && run.bat build",
    "dev:backend": "cd backend && run.bat",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build"
  },
  "keywords": [
    "task-management",
    "react",
    "vite",
    "dotnet",
    "aspnetcore",
    "csharp",
    "sqlite",
    "fullstack"
  ],
